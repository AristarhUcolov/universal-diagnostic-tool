{
  "id": "gaz-mikas71",
  "name": "Микас-5.4 / Микас-7.1 (ГАЗ, УАЗ: ЗМЗ-406, ЗМЗ-409)",
  "vendor": "Элкар",
  "protocol": "legacy",
  "profile": "ru-legacy",
  "family": "gaz-mikas",
  "status": "partial",
  "vehicles": ["ГАЗ-3110, ГАЗ-31105 «Волга» с ЗМЗ-4062", "ГАЗель с ЗМЗ-4063", "УАЗ с ЗМЗ-409 (ранние)"],
  "sources": [
    "«Описание протокола взаимодействия с ЭБУ Микас 5.4 и 7.1 (K-Line)», А. Гуляев, 27.09.2000 (chiptuner.ru, mik_prt.zip)",
    "Fault list: «Руководство по поиску неисправностей в ЭСУД ГАЗ» (2a2.ru)",
    "Checked against a real Микас-5.47 (ZMZ-406, calibration 6/8/98) in a GAZ-3110, journal of 22.10.2026: warm idle 840 rpm, 82 °C, 13.1 V, 14°, 17.3 kg/h air, 1.3 l/h fuel, intake 33 °C; fault list separator 0x40; air flow scale /10 and a one-byte air flow set point, unlike the protocol description"
  ],
  "notes": {
    "en": "Legacy K-Line protocol, 9600 baud, no initialisation. The version request answers 0x09 for Микас-5.4 and 0x0A for Микас-7.1. Main values are checked against a real Микас-5.47; values without a check are marked. Микас-7.1 has not been checked yet.",
    "ru": "Протокол K-Line до KWP2000, 9600 бод, без инициализации. Запрос версии: 0x09 у Микас-5.4, 0x0A у Микас-7.1. Основные параметры сверены с реальным Микас-5.47; непроверенные отмечены. Микас-7.1 пока не проверялся."
  },
  "link": {"baud": 9600},
  "match": {"version": ["09", "0A"]},
  "dtc": {"read": "02", "format": "legacy", "clear": ["62 0E 08", "62 0E 00"]},
  "blocks": [
    {
      "id": "params",
      "name": {"en": "Parameters", "ru": "Параметры"},
      "params": [
        {"id": "twat", "code": "1A", "name": {"en": "Coolant temperature", "ru": "Температура охлаждающей жидкости"}, "expr": "x-40", "unit": "°C", "min": -40, "max": 130, "group": "temperature", "obd": "05", "verified": true},
        {"id": "tair", "code": "1C", "name": {"en": "Intake air temperature", "ru": "Температура воздуха"}, "expr": "x-40", "unit": "°C", "min": -40, "max": 100, "group": "temperature", "obd": "0F", "verified": true},
        {"id": "twati", "code": "19", "name": {"en": "Coolant temperature at start", "ru": "Температура ОЖ при пуске"}, "expr": "x-40", "unit": "°C", "min": -40, "max": 130, "group": "temperature", "verified": true},
        {"id": "freq", "code": "29", "name": {"en": "Engine speed", "ru": "Частота вращения коленвала"}, "expr": "x*40", "unit": "rpm", "min": 0, "max": 6500, "group": "engine", "obd": "0C", "verified": true},
        {"id": "freqx", "code": "2C", "name": {"en": "Engine speed (idle resolution)", "ru": "Обороты холостого хода"}, "expr": "x*10", "unit": "rpm", "min": 0, "max": 2550, "group": "engine"},
        {"id": "thr", "code": "20", "name": {"en": "Throttle position", "ru": "Положение дроссельной заслонки"}, "unit": "%", "min": 0, "max": 100, "group": "air", "obd": "11", "verified": true},
        {"id": "jair", "code": "21", "type": "u16le", "name": {"en": "Mass air flow", "ru": "Расход воздуха"}, "expr": "x/10", "unit": "kg/h", "min": 0, "max": 400, "digits": 1, "group": "air", "obd": "10", "verified": true},
        {"id": "ugb", "code": "59", "name": {"en": "Air flow set point", "ru": "Установка расхода воздуха"}, "expr": "x/10", "unit": "kg/h", "min": 0, "max": 25.5, "digits": 1, "group": "air", "verified": false,
          "note": {"en": "A real Микас-5.47 sends this value as one byte (the protocol description says two); the scale is assumed.", "ru": "Реальный Микас-5.47 передаёт это значение одним байтом (в описании протокола — два); масштаб предположительный."}},
        {"id": "uoz", "code": "26", "type": "s8", "name": {"en": "Ignition advance", "ru": "Угол опережения зажигания"}, "expr": "x/2", "unit": "°", "min": -20, "max": 60, "digits": 1, "group": "ignition", "obd": "0E", "verified": true},
        {"id": "uozoc", "code": "28", "type": "s8", "name": {"en": "Ignition advance correction", "ru": "Поправка УОЗ"}, "expr": "x/2", "unit": "°", "min": -20, "max": 20, "digits": 1, "group": "ignition"},
        {"id": "inj", "code": "3F", "type": "u16le", "name": {"en": "Injection pulse width", "ru": "Длительность впрыска"}, "expr": "x/125", "unit": "ms", "min": 0, "max": 25, "digits": 2, "group": "fuel"},
        {"id": "jqt", "code": "40", "type": "u16le", "name": {"en": "Fuel consumption", "ru": "Часовой расход топлива"}, "expr": "x/10", "unit": "l/h", "min": 0, "max": 40, "digits": 1, "group": "fuel", "obd": "5E", "verified": true},
        {"id": "valf", "code": "39", "name": {"en": "Mixture composition", "ru": "Состав смеси"}, "expr": "0.5+x/256", "min": 0.5, "max": 1.5, "digits": 3, "group": "fuel"},
        {"id": "rcok", "code": "42", "name": {"en": "Fuel correction factor", "ru": "Коэффициент коррекции топливоподачи"}, "expr": "(x-128)/256", "min": -0.5, "max": 0.5, "digits": 3, "group": "fuel", "verified": false,
          "note": {"en": "The source gives |(x-128)/256|-0.5; shown here as (x-128)/256. Check the raw value.", "ru": "В источнике формула |(x-128)/256|-0,5; здесь показано (x-128)/256. Сверяйтесь с сырым значением."}},
        {"id": "rcod", "code": "41", "name": {"en": "Idle CO correction factor", "ru": "Коэффициент коррекции CO на ХХ"}, "expr": "(x-128)/256", "min": -0.5, "max": 0.5, "digits": 3, "group": "fuel", "verified": false,
          "note": {"en": "The source gives |(x-128)/256|-0.5; shown here as (x-128)/256. Check the raw value.", "ru": "В источнике формула |(x-128)/256|-0,5; здесь показано (x-128)/256. Сверяйтесь с сырым значением."}},
        {"id": "uacc", "code": "1E", "name": {"en": "Battery voltage", "ru": "Напряжение бортсети"}, "expr": "x/10", "unit": "V", "min": 8, "max": 16, "digits": 1, "group": "electrical", "obd": "42", "verified": true},
        {"id": "ssm", "code": "5B", "name": {"en": "Idle air valve, set position", "ru": "Установка РДВ"}, "unit": "steps", "min": 0, "max": 255, "group": "idle"},
        {"id": "fsm", "code": "5C", "name": {"en": "Idle air valve, current position", "ru": "Положение РДВ"}, "unit": "steps", "min": 0, "max": 255, "group": "idle"},
        {"id": "rxx", "code": "07", "type": "bit", "bit": 2, "name": {"en": "Idle mode", "ru": "Признак холостого хода"}, "group": "modes"},
        {"id": "bitpow", "code": "07", "type": "bit", "bit": 5, "name": {"en": "Full power mode", "ru": "Признак полной мощности"}, "group": "modes"},
        {"id": "rdet", "code": "07", "type": "bit", "bit": 7, "name": {"en": "Knock ignition correction active", "ru": "Коррекция УОЗ по детонации"}, "group": "modes"},
        {"id": "det", "code": "08", "type": "bit", "bit": 6, "name": {"en": "Knock detected", "ru": "Признак детонации"}, "group": "modes"},
        {"id": "minerr", "code": "72", "name": {"en": "Lowest stored fault number", "ru": "Минимальный номер неисправности"}, "min": 0, "max": 255, "group": "status"}
      ]
    }
  ]
}
