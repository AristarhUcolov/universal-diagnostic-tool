{
  "id": "vaz-m154n-euro2",
  "name": "Bosch M1.5.4N / Январь-5.1 / VS-5.1 (Euro-2)",
  "vendor": "Bosch, Элкар, Итэлма",
  "protocol": "kwp2000",
  "profile": "ru-kwp",
  "family": "ru-kwp",
  "status": "verified",
  "vehicles": ["ВАЗ-2110/2111/2112, 2108/2109/21099, 2115, 2121 с ЭСУД Euro-2", "ГАЗ/УАЗ с ЭБУ Январь-5.1.x / VS-5.1"],
  "sources": ["АвтоВАЗ, Keyword Protocol 2000 specification for M1.5.4N and Январь-5 Euro-2, version I, 04.12.2000 (Д.Б. Дударь)"],
  "notes": {
    "en": "Layout of local identifier 01 taken from the official AvtoVAZ specification. 34 data bytes.",
    "ru": "Раскладка локального идентификатора 01 взята из официальной спецификации АвтоВАЗ. 34 байта данных."
  },
  "link": {"init": "fast", "baud": 10400, "target": "0x10", "tester": "0xF1", "p3min_ms": 100},
  "match": {"block_len": {"21 01": 36}, "ident": ["M1.5.4", "1411020"]},
  "keepalive": "3E 01",
  "ident": [{
    "request": "1A 80",
    "skip": 2,
    "fields": [
      {"key": "vin", "name": {"en": "VIN / vehicle model", "ru": "VIN / модель автомобиля"}, "len": 19},
      {"key": "hw", "name": {"en": "ECU part number (manufacturer)", "ru": "Номер ЭБУ по КД"}, "len": 16},
      {"key": "supplier_hw", "name": {"en": "ECU number (supplier)", "ru": "Номер ЭБУ поставщика"}, "len": 10},
      {"key": "supplier_sw", "name": {"en": "Software number", "ru": "Номер программного обеспечения"}, "len": 10},
      {"key": "engine", "name": {"en": "System name / engine type", "ru": "Система / тип двигателя"}, "len": 15},
      {"key": "repair", "name": {"en": "Spare part code", "ru": "Код запчасти"}, "len": 7},
      {"key": "date", "name": {"en": "Programming date", "ru": "Дата прошивки"}, "len": 10},
      {"key": "ecuid", "name": {"en": "Manufacturer ECU identifier", "ru": "Идентификатор ЭБУ"}, "len": 8}
    ]
  }],
  "dtc": {"read": "18 00 00 00", "format": "kwp", "clear": ["14 00 00"]},
  "blocks": [
    {
      "id": "01",
      "name": {"en": "After-sales data (RLI_ASS)", "ru": "Данные для СТО (RLI_ASS)"},
      "request": "21 01",
      "skip": 2,
      "min_len": 34,
      "params": [
        {"id": "twat", "name": {"en": "Coolant temperature", "ru": "Температура охлаждающей жидкости"}, "offset": 8, "expr": "x-40", "unit": "°C", "min": -40, "max": 130, "group": "temperature", "obd": "05"},
        {"id": "afr", "name": {"en": "Air/fuel ratio", "ru": "Соотношение воздух/топливо"}, "offset": 9, "expr": "14.7*(x+128)/256", "min": 7, "max": 22, "digits": 2, "group": "fuel"},
        {"id": "thr", "name": {"en": "Throttle position", "ru": "Положение дроссельной заслонки"}, "offset": 10, "unit": "%", "min": 0, "max": 100, "group": "air", "obd": "11"},
        {"id": "rpm", "name": {"en": "Engine speed", "ru": "Обороты двигателя"}, "offset": 11, "expr": "x*40", "unit": "rpm", "min": 0, "max": 7000, "group": "engine", "obd": "0C"},
        {"id": "rpm_idle", "name": {"en": "Engine speed (idle resolution)", "ru": "Обороты холостого хода"}, "offset": 12, "expr": "x*10", "unit": "rpm", "min": 0, "max": 2550, "group": "engine"},
        {"id": "iac_desired", "name": {"en": "Idle air control, desired position", "ru": "Желаемое положение РХХ"}, "offset": 13, "unit": "steps", "min": 0, "max": 255, "group": "idle"},
        {"id": "iac", "name": {"en": "Idle air control, current position", "ru": "Текущее положение РХХ"}, "offset": 14, "unit": "steps", "min": 0, "max": 255, "group": "idle"},
        {"id": "inj_corr", "name": {"en": "Injection time correction factor", "ru": "Коэффициент коррекции времени впрыска"}, "offset": 15, "expr": "(x+128)/256", "min": 0.5, "max": 1.5, "digits": 3, "group": "fuel"},
        {"id": "uoz", "name": {"en": "Ignition advance", "ru": "Угол опережения зажигания"}, "offset": 16, "type": "s8", "expr": "x/2", "unit": "°", "min": -20, "max": 50, "digits": 1, "group": "ignition", "obd": "0E"},
        {"id": "speed", "name": {"en": "Vehicle speed", "ru": "Скорость автомобиля"}, "offset": 17, "unit": "km/h", "min": 0, "max": 200, "group": "vehicle", "obd": "0D"},
        {"id": "uacc", "name": {"en": "Battery voltage", "ru": "Напряжение бортсети"}, "offset": 18, "expr": "5.2+x*0.05", "unit": "V", "min": 8, "max": 16, "digits": 2, "group": "electrical", "obd": "42"},
        {"id": "rpm_idle_desired", "name": {"en": "Desired idle speed", "ru": "Желаемые обороты холостого хода"}, "offset": 19, "expr": "x*10", "unit": "rpm", "min": 0, "max": 2000, "group": "idle"},
        {"id": "o2v", "name": {"en": "Oxygen sensor voltage", "ru": "Напряжение датчика кислорода"}, "offset": 20, "expr": "1.25*x/256", "unit": "V", "min": 0, "max": 1.25, "digits": 3, "group": "o2", "obd": "14"},
        {"id": "inj", "name": {"en": "Injection pulse width", "ru": "Длительность импульса впрыска"}, "offset": 22, "type": "u16le", "expr": "x/125", "unit": "ms", "min": 0, "max": 25, "digits": 2, "group": "fuel"},
        {"id": "maf", "name": {"en": "Mass air flow", "ru": "Массовый расход воздуха"}, "offset": 24, "type": "u16le", "expr": "x/10", "unit": "kg/h", "min": 0, "max": 500, "digits": 1, "group": "air", "obd": "10"},
        {"id": "gbc", "name": {"en": "Cyclic air charge", "ru": "Цикловой расход воздуха"}, "offset": 26, "type": "u16le", "expr": "x/6", "unit": "mg/cycle", "min": 0, "max": 1000, "digits": 1, "group": "air"},
        {"id": "fuel_lh", "name": {"en": "Fuel consumption", "ru": "Часовой расход топлива"}, "offset": 28, "type": "u16le", "expr": "x/50", "unit": "l/h", "min": 0, "max": 40, "digits": 2, "group": "fuel", "obd": "5E"},
        {"id": "fuel_100", "name": {"en": "Fuel consumption per 100 km", "ru": "Путевой расход топлива"}, "offset": 30, "type": "u16le", "expr": "x/128", "unit": "l/100km", "min": 0, "max": 50, "digits": 1, "group": "fuel"},
        {"id": "rom_cs", "name": {"en": "ROM checksum", "ru": "Контрольная сумма ПЗУ"}, "offset": 32, "type": "u16le", "min": 0, "max": 65535, "group": "status"},
        {"id": "idle", "name": {"en": "Idle mode", "ru": "Режим холостого хода"}, "offset": 2, "type": "bit", "bit": 1, "group": "modes"},
        {"id": "engine_stopped", "name": {"en": "Engine stopped", "ru": "Двигатель остановлен"}, "offset": 2, "type": "bit", "bit": 0, "group": "modes"},
        {"id": "power_enrich", "name": {"en": "Power enrichment", "ru": "Обогащение по мощности"}, "offset": 2, "type": "bit", "bit": 2, "group": "modes"},
        {"id": "fuel_cut", "name": {"en": "Fuel cut-off", "ru": "Блокировка подачи топлива"}, "offset": 2, "type": "bit", "bit": 3, "group": "modes"},
        {"id": "o2_loop", "name": {"en": "Oxygen sensor control zone (closed loop)", "ru": "Зона регулирования по датчику кислорода"}, "offset": 2, "type": "bit", "bit": 4, "group": "modes"},
        {"id": "knock_zone", "name": {"en": "Knock control zone", "ru": "Зона детонации"}, "offset": 2, "type": "bit", "bit": 5, "group": "modes"},
        {"id": "purge", "name": {"en": "Canister purge enabled", "ru": "Продувка адсорбера разрешена"}, "offset": 2, "type": "bit", "bit": 6, "group": "modes"},
        {"id": "knock", "name": {"en": "Knock detected", "ru": "Обнаружена детонация"}, "offset": 3, "type": "bit", "bit": 5, "group": "modes"},
        {"id": "o2_rich", "name": {"en": "Oxygen sensor reports rich", "ru": "Датчик кислорода: богатая смесь"}, "offset": 3, "type": "bit", "bit": 7, "group": "o2"},
        {"id": "o2_ready", "name": {"en": "Oxygen sensor ready", "ru": "Датчик кислорода готов"}, "offset": 21, "type": "bit", "bit": 0, "group": "o2"},
        {"id": "o2_heat", "name": {"en": "Oxygen sensor heating enabled", "ru": "Нагрев датчика кислорода разрешён"}, "offset": 21, "type": "bit", "bit": 1, "group": "o2"},
        {"id": "config1", "name": {"en": "Configuration word 1", "ru": "Слово комплектации 1"}, "offset": 0, "type": "flags", "group": "config",
          "flags": [{"en": "oxygen sensor", "ru": "датчик кислорода"}, {"en": "canister", "ru": "адсорбер"}, {"en": "EGR valve", "ru": "клапан рециркуляции"}, {"en": "knock sensor", "ru": "датчик детонации"}, {"en": "air temperature sensor", "ru": "датчик температуры воздуха"}, {"en": "phase sensor", "ru": "датчик фазы"}, {"en": "fuel cut-off disabled", "ru": "запрет отсечки топлива"}, {"en": "idle set point adaptation", "ru": "адаптация уставки ХХ"}]},
        {"id": "config2", "name": {"en": "Configuration word 2", "ru": "Слово комплектации 2"}, "offset": 1, "type": "flags", "group": "config",
          "flags": [{"en": "CO potentiometer", "ru": "потенциометр CO"}, {"en": "throttle zero adaptation", "ru": "адаптация нуля дросселя"}, {"en": "asynchronous fuel at start", "ru": "асинхронная подача при пуске"}, {"en": "permanent fault storage", "ru": "постоянное хранение ошибок"}, {"en": "vehicle speed sensor", "ru": "датчик скорости"}, {"en": "simultaneous injection", "ru": "одновременный впрыск"}, {"en": "asynchronous injection on acceleration", "ru": "асинхронный впрыск при ускорении"}, {}]},
        {"id": "faults1", "name": {"en": "Current faults 1", "ru": "Текущие неисправности 1"}, "offset": 4, "type": "flags", "group": "faults",
          "flags": [{"en": "crankshaft sync sensor", "ru": "датчик синхронизации КВ"}, {}, {"en": "EEPROM", "ru": "EEPROM"}, {"en": "oxygen sensor heater", "ru": "нагреватель датчика кислорода"}, {"en": "phase sensor", "ru": "датчик фазы"}, {"en": "processor reset", "ru": "сброс процессора"}, {"en": "RAM", "ru": "ОЗУ"}, {"en": "ROM", "ru": "ПЗУ"}]},
        {"id": "faults2", "name": {"en": "Current faults 2 (signal low)", "ru": "Текущие неисправности 2 (низкий уровень)"}, "offset": 5, "type": "flags", "group": "faults",
          "flags": [{"en": "battery voltage low", "ru": "низкое напряжение бортсети"}, {}, {}, {"en": "coolant sensor low", "ru": "ДТОЖ: низкий уровень"}, {"en": "oxygen sensor low", "ru": "датчик кислорода: низкий уровень"}, {"en": "throttle sensor low", "ru": "ДПДЗ: низкий уровень"}, {"en": "air flow sensor low", "ru": "ДМРВ: низкий уровень"}, {"en": "engine noise low", "ru": "низкий уровень шума двигателя"}]},
        {"id": "faults3", "name": {"en": "Current faults 3 (signal high)", "ru": "Текущие неисправности 3 (высокий уровень)"}, "offset": 6, "type": "flags", "group": "faults",
          "flags": [{"en": "battery voltage high", "ru": "высокое напряжение бортсети"}, {}, {}, {"en": "coolant sensor high", "ru": "ДТОЖ: высокий уровень"}, {"en": "oxygen sensor high", "ru": "датчик кислорода: высокий уровень"}, {"en": "throttle sensor high", "ru": "ДПДЗ: высокий уровень"}, {"en": "air flow sensor high", "ru": "ДМРВ: высокий уровень"}, {"en": "engine noise high", "ru": "высокий уровень шума двигателя"}]},
        {"id": "faults4", "name": {"en": "Current faults 4", "ru": "Текущие неисправности 4"}, "offset": 7, "type": "flags", "group": "faults",
          "flags": [{"en": "knock sensor open", "ru": "обрыв датчика детонации"}, {"en": "no immobiliser link", "ru": "нет связи с иммобилизатором"}, {}, {"en": "no oxygen sensor activity", "ru": "нет активности датчика кислорода"}, {"en": "no O2 response when lean", "ru": "нет отклика ДК при обеднении"}, {"en": "no O2 response when rich", "ru": "нет отклика ДК при обогащении"}, {"en": "vehicle speed sensor", "ru": "датчик скорости"}, {"en": "idle air control", "ru": "регулятор холостого хода"}]}
      ]
    },
    {
      "id": "03",
      "name": {"en": "Factory test: sensor voltages (RLI_FT)", "ru": "Заводской тест: напряжения датчиков (RLI_FT)"},
      "request": "21 03",
      "skip": 2,
      "min_len": 10,
      "params": [
        {"id": "adc_knock", "name": {"en": "Knock channel (ADC)", "ru": "Канал детонации (АЦП)"}, "offset": 0, "expr": "x*5/256", "unit": "V", "min": 0, "max": 5, "digits": 2, "group": "sensors"},
        {"id": "adc_twat", "name": {"en": "Coolant sensor voltage", "ru": "Напряжение ДТОЖ"}, "offset": 1, "expr": "x*5/256", "unit": "V", "min": 0, "max": 5, "digits": 2, "group": "sensors"},
        {"id": "adc_maf", "name": {"en": "Air flow sensor voltage", "ru": "Напряжение ДМРВ"}, "offset": 2, "expr": "x*5/256", "unit": "V", "min": 0, "max": 5, "digits": 2, "group": "sensors"},
        {"id": "adc_uacc", "name": {"en": "Battery voltage (ADC)", "ru": "Напряжение бортсети (АЦП)"}, "offset": 3, "expr": "x*5/256/0.287", "unit": "V", "min": 0, "max": 18, "digits": 2, "group": "sensors", "verified": false,
          "note": {"en": "The specification prints 0.287*E*5/256 (the voltage at the ADC pin); divided by the 0.287 input divider it gives the battery voltage.", "ru": "В спецификации указано 0.287*E*5/256 (напряжение на входе АЦП); с учётом делителя 0.287 получается напряжение бортсети."}},
        {"id": "adc_o2", "name": {"en": "Oxygen sensor voltage (ADC)", "ru": "Напряжение датчика кислорода (АЦП)"}, "offset": 4, "expr": "x*1.25/256", "unit": "V", "min": 0, "max": 1.25, "digits": 3, "group": "sensors"},
        {"id": "adc_tps", "name": {"en": "Throttle sensor voltage", "ru": "Напряжение ДПДЗ"}, "offset": 5, "expr": "x*5/256", "unit": "V", "min": 0, "max": 5, "digits": 2, "group": "sensors"},
        {"id": "fan_relay", "name": {"en": "Cooling fan relay output", "ru": "Выход реле вентилятора"}, "offset": 6, "type": "bit", "bit": 7, "group": "outputs"},
        {"id": "mil_out", "name": {"en": "Check-engine lamp output", "ru": "Выход лампы неисправности"}, "offset": 7, "type": "bit", "bit": 3, "group": "outputs"},
        {"id": "ac_relay", "name": {"en": "A/C relay output", "ru": "Выход реле кондиционера"}, "offset": 7, "type": "bit", "bit": 4, "group": "outputs"}
      ]
    },
    {
      "id": "A0",
      "name": {"en": "Immobiliser status", "ru": "Состояние иммобилизатора"},
      "request": "21 A0",
      "skip": 2,
      "min_len": 2,
      "params": [
        {"id": "immo_link_error", "name": {"en": "Immobiliser link error", "ru": "Ошибка связи с иммобилизатором"}, "offset": 1, "type": "bit", "bit": 4, "group": "immobiliser"},
        {"id": "immo_start_allowed", "name": {"en": "Engine start allowed", "ru": "Пуск разрешён"}, "offset": 1, "type": "bit", "bit": 5, "group": "immobiliser"},
        {"id": "immo_active", "name": {"en": "Immobiliser functions active", "ru": "Функции иммобилизации активны"}, "offset": 1, "type": "bit", "bit": 7, "group": "immobiliser"}
      ]
    }
  ],
  "actuators": [
    {"id": "inj1", "name": {"en": "Injector 1 (pulse)", "ru": "Форсунка 1 (импульс)"}, "kind": "pulse", "on": "30 01 06 01", "off": "30 01 00", "max": 300, "warning": {"en": "Each pulse sprays fuel into the cylinder. Engine stopped, ignition on, not more than a few pulses.", "ru": "Каждый импульс впрыскивает топливо в цилиндр. Двигатель заглушен, зажигание включено, не более нескольких импульсов."}, "condition": "engine_off"},
    {"id": "inj2", "name": {"en": "Injector 2 (pulse)", "ru": "Форсунка 2 (импульс)"}, "kind": "pulse", "on": "30 02 06 01", "off": "30 02 00", "max": 300, "warning": {"en": "Each pulse sprays fuel into the cylinder. Engine stopped, ignition on, not more than a few pulses.", "ru": "Каждый импульс впрыскивает топливо в цилиндр. Двигатель заглушен, зажигание включено, не более нескольких импульсов."}, "condition": "engine_off"},
    {"id": "inj3", "name": {"en": "Injector 3 (pulse)", "ru": "Форсунка 3 (импульс)"}, "kind": "pulse", "on": "30 03 06 01", "off": "30 03 00", "max": 300, "warning": {"en": "Each pulse sprays fuel into the cylinder. Engine stopped, ignition on, not more than a few pulses.", "ru": "Каждый импульс впрыскивает топливо в цилиндр. Двигатель заглушен, зажигание включено, не более нескольких импульсов."}, "condition": "engine_off"},
    {"id": "inj4", "name": {"en": "Injector 4 (pulse)", "ru": "Форсунка 4 (импульс)"}, "kind": "pulse", "on": "30 04 06 01", "off": "30 04 00", "max": 300, "warning": {"en": "Each pulse sprays fuel into the cylinder. Engine stopped, ignition on, not more than a few pulses.", "ru": "Каждый импульс впрыскивает топливо в цилиндр. Двигатель заглушен, зажигание включено, не более нескольких импульсов."}, "condition": "engine_off"},
    {"id": "coil14", "name": {"en": "Ignition coil, cylinders 1 and 4 (pulse)", "ru": "Катушка зажигания цил. 1 и 4 (импульс)"}, "kind": "pulse", "on": "30 05 06 01", "off": "30 05 00", "max": 200, "warning": {"en": "High voltage on the plug leads.", "ru": "Высокое напряжение на проводах свечей."}, "condition": "engine_off"},
    {"id": "coil23", "name": {"en": "Ignition coil, cylinders 2 and 3 (pulse)", "ru": "Катушка зажигания цил. 2 и 3 (импульс)"}, "kind": "pulse", "on": "30 06 06 01", "off": "30 06 00", "max": 200, "warning": {"en": "High voltage on the plug leads.", "ru": "Высокое напряжение на проводах свечей."}, "condition": "engine_off"},
    {"id": "pump", "name": {"en": "Fuel pump relay", "ru": "Реле бензонасоса"}, "kind": "toggle", "on": "30 09 06 01", "off": "30 09 00", "warning": {"en": "Make sure no fuel line is open.", "ru": "Убедитесь, что топливные шланги подсоединены."}, "timeout_s": 30},
    {"id": "fan", "name": {"en": "Cooling fan relay", "ru": "Реле вентилятора охлаждения"}, "kind": "toggle", "on": "30 0A 06 01", "off": "30 0A 00", "warning": {"en": "Keep hands away from the fan.", "ru": "Не держите руки у вентилятора."}},
    {"id": "ac", "name": {"en": "A/C relay", "ru": "Реле кондиционера"}, "kind": "toggle", "on": "30 0B 06 01", "off": "30 0B 00"},
    {"id": "mil", "name": {"en": "Check-engine lamp", "ru": "Лампа неисправности"}, "kind": "toggle", "on": "30 0C 06 01", "off": "30 0C 00"},
    {"id": "purge", "name": {"en": "Canister purge valve", "ru": "Клапан продувки адсорбера"}, "kind": "toggle", "on": "30 0D 06 01", "off": "30 0D 00"},
    {"id": "iac_pos", "name": {"en": "Idle air control position", "ru": "Положение РХХ"}, "kind": "value", "set": "30 41 07 {v}", "off": "30 41 00", "min": 0, "max": 255, "unit": "steps"},
    {"id": "idle_rpm", "name": {"en": "Idle speed set point", "ru": "Обороты холостого хода"}, "kind": "value", "set": "30 42 07 {v/10}", "off": "30 42 00", "min": 600, "max": 1600, "unit": "rpm", "warning": {"en": "The engine must be running and warm.", "ru": "Двигатель должен работать и быть прогретым."}, "condition": "engine_running"}
  ]
}
